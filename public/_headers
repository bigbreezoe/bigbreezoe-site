# Security and cache headers for the static site (Cloudflare Pages reads this file).
# These apply to files served from public/. The /go/ redirects run through the bb-go Worker instead.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# Preview and branch deployments on *.pages.dev must never be indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

/checkout/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/booked/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/upload/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/store/audio-kit/download/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/polish.css*
  Cache-Control: public, max-age=600, must-revalidate

/og.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
